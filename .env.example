# Placeholder -- real variables land alongside the Milestones that need
# them (Milestone 2 for DATABASE_URL/REDIS_URL, Milestone 3 for MinIO,
# Milestone 6 for AI provider keys, etc.). See PROJECT_STATE.md section 2
# for the full target technology stack.
#
# This file is never committed with real values -- .gitignore already
# excludes .env while allowing .env.example.

# --- Milestone 2 ---

# postgresql+asyncpg://<user>:<password>@<host>:5432/<database> -- async
# driver scheme, matching the locked "SQLAlchemy async" decision
# (PROJECT_STATE.md section 2). Required for every worker_role except
# scanner_worker (app/config.py enforces this at Settings construction
# time; scanner_worker must never be handed database credentials at all
# -- see docs/security_model.md on scanner network isolation).
DATABASE_URL=postgresql+asyncpg://app_user:change_me_dev_only@localhost:5432/security_platform

# Used by the repository integration suite (backend/tests/integration/)
# instead of DATABASE_URL, so running tests never points at the same
# database as local development. Not read by application code -- only by
# tests/conftest.py. Defaults to this same value if unset.
TEST_DATABASE_URL=postgresql+asyncpg://app_user:change_me_dev_only@localhost:5432/security_platform_test

# redis://<host>:6379/<db> -- required for every worker_role
# (app/config.py); not yet consumed by any code as of Milestone 2 (no
# Celery/queue integration exists yet), but Settings validates its
# presence regardless, per the Milestone 1 role-based fail-fast design.
REDIS_URL=redis://localhost:6379/0

# --- Milestone 3 ---

# app/config.py has required these three for every worker_role since
# Milestone 1 ("every role needs object storage -- even scanner_worker,
# which writes raw scan output to MinIO for the ingestion worker to pick
# up"), but no code consumed them until this milestone's
# app/infrastructure/storage/minio_storage.py (MinioStoragePort).
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_dev_only

# --- Milestone 5 ---

# The bucket app/main.py's composition root passes to MinioStoragePort
# when constructing it for the running API process -- required for every
# worker_role, same as the three MinIO settings above (app/config.py),
# but not consumed by any code until this milestone actually builds a
# process that constructs MinioStoragePort through Settings (Milestones
# 3-4 only ever constructed it directly in tests, with an explicit
# bucket argument, never through Settings).
MINIO_BUCKET=scan-raw-output

# Required for worker_role=api since Milestone 1 (app/config.py), but
# never added here until this milestone, since no runnable API process
# existed yet for its absence to actually block anything. Generate a
# real value with, e.g., `openssl rand -hex 32` for anything beyond
# local dev -- app/config.py's production check rejects the placeholder
# below (change_me_dev_only) if ENVIRONMENT=production.
JWT_SECRET=change_me_dev_only

# --- Milestone 6 ---

# app/config.py has named ai_default_provider/anthropic_api_key/
# openai_api_key/openrouter_api_key/ollama_base_url since Milestone 1 as
# forward-looking config (PROJECT_STATE.md section 3: "four named
# providers already in scope justifies the interface"), but no code
# consumed any of them until this milestone's AIProviderPort/
# AnthropicProvider/AnalysisService. AI_DEFAULT_PROVIDER and AI_MODEL
# both have real code defaults ("anthropic" and "claude-sonnet-4-5"
# respectively) and do not need to be set explicitly for local
# development -- included here for documentation, matching the pattern
# already established for other defaulted-but-overridable settings.
# ANTHROPIC_API_KEY has no default and is required for
# worker_role=ingestion_worker whenever AI_DEFAULT_PROVIDER=anthropic
# (the default) -- app/config.py enforces this at Settings construction
# time, the same fail-fast pattern already applied to JWT_SECRET above.
# Required for worker_role=ingestion_worker, not worker_role=api, as of
# Milestone 7: RunScanWorkflowUseCase (and therefore AnalysisService)
# moved from running inside the API's HTTP request handler to running
# inside the ingestion_worker Celery task -- see app/config.py's
# check_role_boundaries and app/workers/tasks.py's module docstring.
# app/config.py's production check also rejects the placeholder below
# (change_me_dev_only) if ENVIRONMENT=production, the same as every
# other secret in this file.
AI_DEFAULT_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=change_me_dev_only

# --- Milestone 7 ---

# No new variable names -- REDIS_URL (already required for every
# worker_role since Milestone 1, "Milestone 2" section above) is what
# app/workers/celery_app.py now actually points Celery's broker and
# result backend at; nothing new to add here for that. ANTHROPIC_API_KEY
# (above) moved from being required for worker_role=api to
# worker_role=ingestion_worker -- see app/config.py's
# check_role_boundaries and app/main.py's/app/workers/tasks.py's module
# docstrings for the full account of why (RunScanWorkflowUseCase, and
# therefore AnalysisService/AnthropicProvider, now runs inside the
# ingestion_worker Celery task instead of the API's HTTP request
# handler). Both variables are still named and described exactly once,
# above, under the milestone that first introduced them -- this section
# exists only to record that no new configuration surface was added.

