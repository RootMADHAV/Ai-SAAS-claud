# Copy to .env.local (gitignored) for local dev; adjust only if you change
# the backend's local port. Never commit .env.local -- see frontend/README.md
# for the full local-HTTPS (mkcert) setup this value depends on.

# Backend origin. Must be https:// locally: the backend's auth cookies are
# always set with the Secure attribute (PROJECT_STATE.md section 4, locked,
# unconditional), and a Secure cookie is only stored by the browser if the
# response that set it arrived over HTTPS -- this is true regardless of what
# scheme the frontend itself is served over. Run the backend locally with
# --ssl-keyfile/--ssl-certfile pointed at the same mkcert certs used below
# (see frontend/README.md) so this actually works.
NEXT_PUBLIC_API_BASE_URL=https://localhost:8000
